# DeepSeek LLM 配置
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Tavily 搜索 API
TAVILY_API_KEY=tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 每日生成简报时间（24 小时制）
BRIEFING_HOUR=8
BRIEFING_MINUTE=0

# 应用监听
APP_HOST=127.0.0.1
APP_PORT=8000
